<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/daily_widget_task_row" android:layout_width="match_parent" android:layout_height="wrap_content"
  android:minHeight="72dp" android:layout_marginBottom="6dp" android:padding="10dp" android:orientation="vertical" android:background="@drawable/daily_widget_card">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@+id/daily_widget_task_icon" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginEnd="8dp" android:gravity="center" android:fontFamily="sans-serif-medium" android:textSize="16sp" android:includeFontPadding="false" android:maxLines="1" android:background="@drawable/daily_widget_action" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="8dp">
      <TextView android:id="@+id/daily_widget_task_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:textSize="15sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
      <TextView android:id="@+id/daily_widget_task_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFamily="sans-serif" android:fontFeatureSettings="tnum" android:textSize="12sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
      <ProgressBar android:id="@+id/daily_widget_task_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="6dp" android:progressDrawable="@drawable/daily_widget_progress" />
    </LinearLayout>
    <TextView android:id="@+id/daily_widget_task_add" android:layout_width="72dp" android:layout_height="48dp" android:gravity="center" android:text="+1" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:textSize="13sp" android:includeFontPadding="false" android:background="@drawable/daily_widget_action" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" />
  </LinearLayout>
  <LinearLayout android:id="@+id/daily_widget_task_timer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="6dp">
      <TextView android:id="@+id/daily_widget_task_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:textSize="11sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
      <Chronometer android:id="@+id/daily_widget_task_clock" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:textSize="14sp" android:includeFontPadding="false" android:maxLines="1" />
    </LinearLayout>
    <TextView android:id="@+id/daily_widget_task_finish" android:layout_width="72dp" android:layout_height="48dp" android:layout_marginStart="6dp" android:gravity="center" android:text="Save" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:textSize="12sp" android:includeFontPadding="false" android:visibility="gone" android:background="@drawable/daily_widget_save" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" />
  </LinearLayout>
</LinearLayout>
