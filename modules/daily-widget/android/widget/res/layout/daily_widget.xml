<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/daily_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="vertical" android:padding="14dp" android:background="@drawable/daily_widget_background">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <TextView android:id="@+id/daily_widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Daily+" android:fontFamily="sans-serif-medium" android:textSize="19sp" android:includeFontPadding="false" />
    <TextView android:id="@+id/daily_widget_today" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/daily_widget_today" android:fontFamily="sans-serif-medium" android:textSize="13sp" android:includeFontPadding="false" />
  </LinearLayout>
  <TextView android:id="@+id/daily_widget_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="sans-serif-medium" android:textSize="13sp" android:fontFeatureSettings="tnum" android:includeFontPadding="false" />
  <TextView android:id="@+id/daily_widget_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:fontFamily="sans-serif" android:textSize="16sp" />
  <LinearLayout android:id="@+id/daily_widget_rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:orientation="vertical" />
  <TextView android:id="@+id/daily_widget_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:textSize="13sp" android:maxLines="1" android:includeFontPadding="false" android:visibility="gone" />
</LinearLayout>
